<form>
  <select id="id_chart_project" class="custom-select" aria-label="Default select">
  <option value='0' selected>KSA01</option>
  </select>
  <select id="id_chart_year" class="custom-select" aria-label="Default select">
  <option value='2025' selected>2025</option>
  </select>
  <select id="id_chart_month" class="custom-select" aria-label="Default select">
  <option value='0'>All Months</option>
  <option value='1' >January</option>
   <option value='2' >February</option>
    <option value='3' >March</option>
     <option value='4' >April</option>
      <option value='5' >May</option>
       <option value='6' >June</option>
        <option value='7' >July</option>
         <option value='8' >August</option>
          <option value='9' >September</option>
           <option value='10' >October</option>
            <option value='11' >November</option>
             <option value='12' >December</option>
  </select>
        
  <button id="id_chart_boclick" type="button" class="btn btn-primary">Click me!</button>
  <input type="hidden" name="token" value="{{token}}">
  </form>

<div id="barchartpanel">
    {{>block_charts/barchart}}
    
</div>

